# Server
NODE_ENV=development
PORT=4000
# Base URL clients use to reach this API (used to build uploaded file URLs).
# On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:4000
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/feedants

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Allows picking a seeded demo user without a password. Keep false in production.
ALLOW_DEMO_LOGIN=true

# Payments ("mock" mirrors Razorpay's order + signed-callback flow)
PAYMENT_PROVIDER=mock
# How long an unpaid registration holds a seat
PAYMENT_HOLD_MINUTES=10
HOLD_SWEEP_INTERVAL_MS=30000

# Submissions
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100

# Referral links
REFERRAL_BASE_URL=https://feedants.com/r
